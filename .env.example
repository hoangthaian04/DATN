# Biến môi trường mẫu cho Docker Compose (sao chép thành .env)
POSTGRES_DB=easytech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Secret
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost
APP_PUBLIC_BASE_URL=http://localhost

# SMTP (Mailpit local mặc định; điền username/password nếu dùng SMTP thật)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@easyhire.local

# Google OAuth 2.0
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# AI (chỉ cấu hình local/server, không commit API key thật)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MAX_INPUT_CHARS=40000
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_BACKOFF_MILLIS=800
AI_MATCHING_EMBEDDING_MODEL=gemini-embedding-001
AI_MATCHING_INPUT_MAX_CHARS=8000
AI_MATCHING_BATCH_SIZE=32
AI_MATCHING_POLL_INTERVAL_MS=2000
AI_MATCHING_LEASE_SECONDS=120
# Khóa AES dùng để giải mã custom provider key đã mã hóa trong ai_providers
AI_ENCRYPTION_KEY=
