# Biến môi trường cho Docker Compose
# Sao chép file này thành .env và chỉnh sửa theo môi trường của bạn

# PostgreSQL
POSTGRES_DB=easytech
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Secret (đổi thành chuỗi bí mật ngẫu nhiên trong môi trường Production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost
